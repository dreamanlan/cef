diff --git a/BUILD.gn b/BUILD.gn
index ae04ae3bb..90797be7a 100644
--- a/BUILD.gn
+++ b/BUILD.gn
@@ -306,6 +306,14 @@ includes_mac = gypi_paths2.includes_mac + gypi_paths2.includes_mac_capi
 includes_linux = gypi_paths2.includes_linux + gypi_paths2.includes_linux_capi
 includes_win = gypi_paths2.includes_win + gypi_paths2.includes_win_capi
 
+# Explicit source lists for the myapp fork (webagent / websimple); see
+# myapp/myapp_sources.gypi. Loaded at global scope so both the macOS (cef_app
+# bundle) and non-macOS (executable) target blocks below can consume it.
+myapp_paths = exec_script("//cef/tools/gypi_to_gn.py",
+                          [ rebase_path("myapp/myapp_sources.gypi") ],
+                          "scope",
+                          [ "myapp/myapp_sources.gypi" ])
+
 # CAPI-only includes for pure C implementations.
 includes_common_capi = gypi_paths2.includes_common_capi + gypi_paths2.includes_capi
 includes_mac_capi = gypi_paths2.includes_mac_capi
@@ -1979,6 +1987,10 @@ if (is_mac) {
           cflags_c = invoker.helper_cflags_c
         }
 
+        if (defined(invoker.helper_libs)) {
+          libs = invoker.helper_libs
+        }
+
         # Disable clang modules for this target (see issue #3611).
         use_libcxx_modules = false
       }
@@ -2015,6 +2027,9 @@ if (is_mac) {
         if (defined(invoker.helper_cflags_c)) {
           helper_cflags_c = invoker.helper_cflags_c
         }
+        if (defined(invoker.helper_libs)) {
+          helper_libs = invoker.helper_libs
+        }
 
         helper_name_suffix = _helper_suffix
         helper_bundle_id_suffix = _helper_bundle_id
@@ -2079,6 +2094,10 @@ if (is_mac) {
         cflags_c = invoker.cflags_c
       }
 
+      if (defined(invoker.libs)) {
+        libs = invoker.libs
+      }
+
       info_plist_target = ":${app_name}_plist"
 
       # Disable clang modules for this target (see issue #3611).
@@ -2239,6 +2258,173 @@ if (is_mac) {
   }
 
 
+  #
+  # webagent app targets (myapp fork of cefclient).
+  #
+
+  bundle_data("webagent_resources_bundle_data") {
+    sources = myapp_paths.myapp_shared_sources_resources +
+              myapp_paths.myapp_cefclient_sources_resources + [
+      "myapp/cefclient/mac/cefclient.icns",
+    ]
+
+    outputs = [
+      "{{bundle_resources_dir}}/{{source_file_part}}",
+    ]
+  }
+
+  bundle_data("webagent_resources_bundle_data_english") {
+    sources = [
+      "myapp/cefclient/mac/English.lproj/InfoPlist.strings",
+    ]
+
+    outputs = [
+      "{{bundle_resources_dir}}/English.lproj/{{source_file_part}}",
+    ]
+  }
+
+  mac_xib_bundle_data("webagent_xibs") {
+    sources = [
+      "myapp/cefclient/mac/English.lproj/MainMenu.xib",
+    ]
+
+    output_path = "{{bundle_resources_dir}}/English.lproj"
+  }
+
+  cef_app("webagent") {
+    # Necessary because the cef_framework target is testonly.
+    testonly = true
+
+    helper_info_plist = "myapp/cefclient/mac/helper-Info.plist.in"
+    helper_sources = includes_common +
+                     includes_mac +
+                     gypi_paths2.includes_wrapper +
+                     gypi_paths2.includes_wrapper_mac +
+                     myapp_paths.myapp_shared_sources_common +
+                     myapp_paths.myapp_shared_sources_renderer +
+                     myapp_paths.myapp_shared_sources_mac_helper +
+                     myapp_paths.myapp_cefclient_sources_common +
+                     myapp_paths.myapp_cefclient_sources_renderer
+    helper_deps = [
+      ":libcef_dll_wrapper",
+    ]
+    helper_defines = [
+      "CEF_USE_SANDBOX",
+
+      # The Helper app does not include the browser-only source list
+      # (myapp_cefclient_sources_browser), so browser/custom_scheme.cc is not
+      # compiled here. HostCLR.cpp is in the shared common list and would
+      # otherwise reference its symbols; this define stubs out those calls.
+      "WEBAGENT_HELPER_PROCESS",
+    ]
+    helper_libs = [
+      "//cef/myapp/cefclient/hostclr/coreclr/libnethost.a",
+      "c++",
+    ]
+
+    info_plist = "myapp/cefclient/mac/Info.plist.in"
+    sources = includes_common +
+              includes_mac +
+              gypi_paths2.includes_wrapper +
+              gypi_paths2.includes_wrapper_mac +
+              myapp_paths.myapp_shared_sources_browser +
+              myapp_paths.myapp_shared_sources_common +
+              myapp_paths.myapp_shared_sources_mac +
+              myapp_paths.myapp_cefclient_sources_browser +
+              myapp_paths.myapp_cefclient_sources_common +
+              myapp_paths.myapp_cefclient_sources_mac
+    deps = [
+      ":libcef_dll_wrapper",
+      ":webagent_resources_bundle_data",
+      ":webagent_resources_bundle_data_english",
+      ":webagent_xibs",
+    ]
+    frameworks = [
+      "AppKit.framework",
+      "IOSurface.framework",
+      "OpenGL.framework",
+      "Security.framework",
+    ]
+    defines = [
+      "CEF_USE_SANDBOX",
+    ]
+    libs = [
+      "//cef/myapp/cefclient/hostclr/coreclr/libnethost.a",
+      "c++",
+    ]
+  }
+
+
+  #
+  # websimple app targets (myapp fork of cefsimple).
+  #
+
+  bundle_data("websimple_resources_bundle_data") {
+    sources = [
+      "myapp/cefsimple/mac/cefsimple.icns",
+    ]
+
+    outputs = [
+      "{{bundle_resources_dir}}/{{source_file_part}}",
+    ]
+  }
+
+  bundle_data("websimple_resources_bundle_data_english") {
+    sources = [
+      "myapp/cefsimple/mac/English.lproj/InfoPlist.strings",
+    ]
+
+    outputs = [
+      "{{bundle_resources_dir}}/English.lproj/{{source_file_part}}",
+    ]
+  }
+
+  mac_xib_bundle_data("websimple_xibs") {
+    sources = [
+      "myapp/cefsimple/mac/English.lproj/MainMenu.xib",
+    ]
+    output_path = "{{bundle_resources_dir}}/English.lproj"
+  }
+
+  cef_app("websimple") {
+    # Necessary because the cef_framework target is testonly.
+    testonly = true
+
+    helper_info_plist = "myapp/cefsimple/mac/helper-Info.plist.in"
+    helper_sources = includes_common +
+                     includes_mac +
+                     gypi_paths2.includes_wrapper +
+                     gypi_paths2.includes_wrapper_mac +
+                     myapp_paths.myapp_cefsimple_sources_mac_helper
+    helper_deps = [
+      ":libcef_dll_wrapper",
+    ]
+    helper_defines = [
+      "CEF_USE_SANDBOX",
+    ]
+
+    info_plist = "myapp/cefsimple/mac/Info.plist.in"
+    sources = includes_common +
+              includes_mac +
+              gypi_paths2.includes_wrapper +
+              gypi_paths2.includes_wrapper_mac +
+              myapp_paths.myapp_cefsimple_sources_common +
+              myapp_paths.myapp_cefsimple_sources_mac
+    deps = [
+      ":libcef_dll_wrapper",
+      ":websimple_resources_bundle_data",
+      ":websimple_resources_bundle_data_english",
+      ":websimple_xibs",
+    ]
+    frameworks = [
+      "AppKit.framework",
+    ]
+    defines = [
+      "CEF_USE_SANDBOX",
+    ]
+  }
+
+
   #
   # cefsimple_capi app targets (Pure C API implementation).
   #
@@ -2713,6 +2899,223 @@ if (is_mac) {
   }
 
 
+  #
+  # myapp executable targets (webagent / websimple) for Windows and Linux.
+  #
+  # Source lists come from myapp/myapp_sources.gypi via the global myapp_paths
+  # scope. This correctly handles myapp-only files (hostclr) and renamed
+  # resources (webagent.ico / websimple.ico). macOS is handled separately by
+  # the cef_app bundle targets above.
+  #
+
+  # myapp_cefclient common (non-platform) sources.
+  myapp_cefclient_sources =
+      myapp_paths.myapp_shared_sources_browser +
+      myapp_paths.myapp_shared_sources_common +
+      myapp_paths.myapp_shared_sources_renderer +
+      myapp_paths.myapp_cefclient_sources_browser +
+      myapp_paths.myapp_cefclient_sources_common +
+      myapp_paths.myapp_cefclient_sources_renderer
+
+  # myapp_cefsimple common (non-platform) sources.
+  myapp_cefsimple_sources = myapp_paths.myapp_cefsimple_sources_common
+
+  # Platform-specific source lists are assigned inside their matching platform
+  # guard so the assignment is always consumed (GN treats an unread assignment
+  # as an error; is_linux vars would be unused on Windows and vice versa).
+  if (is_win) {
+    myapp_cefclient_sources_win =
+        myapp_paths.myapp_shared_sources_win +
+        myapp_paths.myapp_cefclient_sources_win +
+        myapp_paths.myapp_cefclient_sources_resources_win_rc
+
+    myapp_cefsimple_sources_win =
+        myapp_paths.myapp_cefsimple_sources_win +
+        myapp_paths.myapp_cefsimple_sources_resources_win_rc
+  }
+
+  if (is_linux) {
+    myapp_cefclient_sources_linux =
+        myapp_paths.myapp_shared_sources_linux +
+        myapp_paths.myapp_cefclient_sources_linux
+
+    myapp_cefsimple_sources_linux = myapp_paths.myapp_cefsimple_sources_linux
+  }
+
+  if (is_linux) {
+    myapp_cefclient_sources_resources =
+        myapp_paths.myapp_shared_sources_resources +
+        myapp_paths.myapp_cefclient_sources_resources
+
+    copy("copy_myapp_cefclient_files") {
+      sources = myapp_cefclient_sources_resources
+      outputs = [ "${root_out_dir}/myapp_cefclient_files/{{source_file_part}}" ]
+    }
+  }
+
+  executable("webagent") {
+    # Necessary because the libcef target is testonly.
+    testonly = true
+
+    sources = includes_common +
+              gypi_paths2.includes_wrapper +
+              myapp_cefclient_sources
+
+    deps = [
+      ":libcef",
+      ":libcef_dll_wrapper",
+    ]
+
+    defines = [
+      "CEF_USE_SANDBOX",
+    ]
+
+    # Disable clang modules for this target (see issue #3611).
+    use_libcxx_modules = false
+
+    if (is_win) {
+      sources += includes_win +
+                 gypi_paths2.includes_wrapper_win +
+                 myapp_cefclient_sources_win
+
+      # Set /SUBSYSTEM:WINDOWS.
+      configs -= [ "//build/config/win:console" ]
+      configs += [ "//build/config/win:windowed" ]
+
+      # Delay-load as many DLLs as possible for sandbox and startup perf
+      # improvements.
+      configs += [
+        "//build/config/win:delayloads",
+        "//build/config/win:delayloads_not_for_child_dll",
+      ]
+
+      defines += [
+        "CEF_USE_ATL",
+      ]
+
+      deps += [
+        ":cef_sandbox",
+        "//build/win:default_exe_manifest",
+      ]
+
+      libs = [
+        "comctl32.lib",
+        "d3d11.lib",
+        "imm32.lib",
+        "oleacc.lib",
+        "rpcrt4.lib",
+        "shlwapi.lib",
+      ]
+
+      if (target_cpu != "arm64") {
+        libs += [
+          "glu32.lib",
+          "opengl32.lib",
+        ]
+        ldflags = [
+          "/DELAYLOAD:glu32.dll",
+          "/DELAYLOAD:oleaut32.dll",
+          "/DELAYLOAD:opengl32.dll",
+        ]
+      }
+    }
+
+    if (is_linux) {
+      sources += includes_linux +
+                 myapp_cefclient_sources_linux
+
+      deps += [
+        ":copy_myapp_cefclient_files",
+      ]
+
+      libs = [
+        "GL",
+        "X11",
+      ]
+
+      if (cef_use_gtk) {
+        configs += [
+          ":gtk",
+        ]
+        cflags = [
+          # Don't warn about deprecated GDK/GTK functions.
+          "-Wno-deprecated-declarations",
+        ]
+      }
+
+      if (!is_component_build) {
+        # Set rpath to find our own libfreetype even in a non-component build.
+        configs += [ "//build/config/gcc:rpath_for_built_shared_libraries" ]
+      }
+    }
+  }
+
+  executable("websimple") {
+    # Necessary because the libcef target is testonly.
+    testonly = true
+
+    sources = includes_common +
+              gypi_paths2.includes_wrapper +
+              myapp_cefsimple_sources
+
+    deps = [
+      ":libcef",
+      ":libcef_dll_wrapper",
+    ]
+
+    defines = [
+      "CEF_USE_SANDBOX",
+    ]
+
+    # Disable clang modules for this target (see issue #3611).
+    use_libcxx_modules = false
+
+    if (is_win) {
+      sources += includes_win +
+                 gypi_paths2.includes_wrapper_win +
+                 myapp_cefsimple_sources_win
+
+      # Set /SUBSYSTEM:WINDOWS.
+      configs -= [ "//build/config/win:console" ]
+      configs += [ "//build/config/win:windowed" ]
+
+      # Delay-load as many DLLs as possible for sandbox and startup perf
+      # improvements.
+      configs += [
+        "//build/config/win:delayloads",
+        "//build/config/win:delayloads_not_for_child_dll",
+      ]
+
+      deps += [
+        ":cef_sandbox",
+        "//build/win:default_exe_manifest",
+      ]
+
+      libs = [
+        "comctl32.lib",
+        "shlwapi.lib",
+        "rpcrt4.lib",
+      ]
+    }
+
+    if (is_linux) {
+      sources += includes_linux +
+                 myapp_cefsimple_sources_linux
+
+      if (ozone_platform_x11) {
+        libs = [
+          "X11",
+        ]
+      }
+
+      if (!is_component_build) {
+        # Set rpath to find our own libfreetype even in a non-component build.
+        configs += [ "//build/config/gcc:rpath_for_built_shared_libraries" ]
+      }
+    }
+  }
+
+
   #
   # cefsimple_capi targets (Pure C API implementation).
   #
